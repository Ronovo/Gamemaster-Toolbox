{
  // Development is as quiet as production -- see appsettings.json for why. To watch the SQL EF
  // Core is running while debugging a query, add "Microsoft.EntityFrameworkCore.Database.Command":
  // "Information" here; this file is not deployed, so it cannot follow you into a release.
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
