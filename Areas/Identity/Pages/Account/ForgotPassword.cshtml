@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Reset password";
}

<h1>@ViewData["Title"]</h1>
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="All" class="text-danger" role="alert"></div>
            @if (Model.Question == null)
            {
                <div class="form-floating mb-3">
                    <input asp-for="UserName" class="form-control" autocomplete="username" placeholder="Username" required />
                    <label asp-for="UserName">Username</label>
                </div>
                <button type="submit" class="w-100 btn btn-lg btn-primary">Next</button>
            }
            else
            {
                <input type="hidden" asp-for="UserName" />
                <input type="hidden" asp-for="Question" />
                <p>@Model.Question</p>
                <div class="form-floating mb-3">
                    <input asp-for="Answer" class="form-control" maxlength="100" autocomplete="off" placeholder="Answer" required />
                    <label asp-for="Answer">Answer</label>
                </div>
                <div class="form-floating mb-3">
                    <input asp-for="NewPassword" class="form-control" type="password" autocomplete="new-password" placeholder="New password" required />
                    <label asp-for="NewPassword">New password</label>
                </div>
                <button type="submit" asp-page-handler="Reset" class="w-100 btn btn-lg btn-primary">Reset password</button>
            }
        </form>
    </div>
</div>
