@page
@model SecurityQuestionModel
@{
    ViewData["Title"] = "Security question";
}

<h1>@ViewData["Title"]</h1>
@if (!Model.HasPassword)
{
    <p>This account logs in with the portfolio and has no password here, so it has no security question.
        A forgotten portfolio password is reset on the portfolio.</p>
    return;
}
<div class="row">
    <div class="col-md-4">
        <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
            <div asp-validation-summary="All" class="text-danger" role="alert"></div>
            <partial name="_SecurityFields" model="(Model.Input.Question, nameof(Model.Input))" />
            @if (Model.HasQuestion)
            {
                <div class="form-floating mb-3">
                    <input asp-for="Input.CurrentPassword" type="password" class="form-control" autocomplete="current-password" placeholder="Current password" />
                    <label asp-for="Input.CurrentPassword">Current password</label>
                </div>
            }
            <button type="submit" class="w-100 btn btn-lg btn-primary">Save</button>
        </form>
    </div>
</div>
