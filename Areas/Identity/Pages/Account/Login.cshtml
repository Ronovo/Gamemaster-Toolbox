@page
@model LoginModel
@inject GM_Toolbox.Services.PortfolioLogin Portfolio
@{
    ViewData["Title"] = "Log in";
}

<h1>@ViewData["Title"]</h1>
<div class="row">
    <div class="col-md-4">
        @if (Portfolio.Enabled)
        {
            <p><a class="w-100 btn btn-lg btn-primary portfolio-button" href="/sso/login" data-portfolio-url="@Portfolio.Url">Log in with portfolio account</a></p>
        }
        <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
            <div asp-validation-summary="All" class="text-danger" role="alert"></div>
            @if (Model.WasReset)
            {
                <div class="alert alert-success">Password changed. Log in with your new password.</div>
            }
            <div class="form-floating mb-3">
                <input asp-for="Input.UserName" class="form-control" autocomplete="username" placeholder="Username" />
                <label asp-for="Input.UserName"></label>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Password" class="form-control" autocomplete="current-password" placeholder="Password" />
                <label asp-for="Input.Password"></label>
            </div>
            <div class="checkbox mb-3">
                <label asp-for="Input.RememberMe" class="form-label">
                    <input class="form-check-input" asp-for="Input.RememberMe" />
                    @Html.DisplayNameFor(m => m.Input.RememberMe)
                </label>
            </div>
            <button type="submit" class="w-100 btn btn-lg @(Portfolio.Enabled ? "btn-outline-primary" : "btn-primary")">Log in</button>
            <p class="mt-3">
                <a asp-page="./ForgotPassword">Forgot your password?</a><br />
                <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Register as a new user</a>
            </p>
        </form>
    </div>
</div>
