@using GM_Toolbox.Models.ViewModels
@model GameSystemIndexViewModel

@{
    ViewData["Title"] = "Game Systems";
}

<h1>Game Systems</h1>

@if (TempData["ImportMessage"] != null)
{
    <div class="alert alert-success">@TempData["ImportMessage"]</div>
}

<p>
    <a asp-action="Create">Add New</a>
    <a asp-controller="Oracles" asp-action="Export" asp-route-returnTo="GameSystems">Export</a>
    <a asp-controller="Oracles" asp-action="Import" asp-route-returnTo="GameSystems">Import</a>
</p>

@if (!Model.CatalogEmpty)
{
    <form method="get" asp-action="Index" class="mb-3" data-live-filter data-results="#list-results" data-partial="1">
        <div class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label" asp-for="Name"></label>
                <input asp-for="Name" class="form-control" autocomplete="off" />
            </div>
            <div class="col-md-4">
                <label class="form-label" asp-for="Genre"></label>
                <input asp-for="Genre" class="form-control" autocomplete="off" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-outline-secondary">Filter</button>
            </div>
        </div>
    </form>
}

<div id="list-results">
    <partial name="_GameSystemListResults" model="Model" />
</div>
