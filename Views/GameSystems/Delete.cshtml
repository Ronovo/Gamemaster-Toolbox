@model GM_Toolbox.Models.GameSystem

@{
    ViewData["Title"] = "Delete Game System";
    var oracleCount = (int)(ViewData["OracleCount"] ?? 0);
    var flowCount = (int)(ViewData["FlowCount"] ?? 0);

    var uses = new List<string>();
    if (oracleCount > 0) { uses.Add($"{oracleCount} oracle(s)"); }
    if (flowCount > 0) { uses.Add($"{flowCount} flow(s)"); }
}

<h1>Delete Game System</h1>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Game System</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Name)</dt>
        <dd class="col-sm-10">@Model.Name</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Genre)</dt>
        <dd class="col-sm-10">@Model.Genre</dd>
    </dl>

    @if (uses.Any())
    {
        <div class="alert alert-warning">
            This system is used by @string.Join(" and ", uses) and can't be deleted until those are changed or removed.
        </div>
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    }
    else
    {
        <form asp-action="Delete">
            <input type="hidden" asp-for="ID" />
            <input type="submit" value="Delete" class="btn btn-danger" /> |
            <a asp-action="Index">Back to List</a>
        </form>
    }
</div>