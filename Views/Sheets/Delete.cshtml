@model GM_Toolbox.Models.Sheet

@{
    ViewData["Title"] = "Delete Sheet";
}

<h1>Delete Sheet</h1>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Sheet</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Filename</dt>
        <dd class="col-sm-10">@Model.FileName</dd>
        <dt class="col-sm-2">Versions</dt>
        <dd class="col-sm-10">@Model.Versions.Count</dd>
    </dl>

    <div class="alert alert-warning">
        This deletes every version of this sheet, including its stored PDF files. This cannot be undone.
    </div>

    <form asp-action="Delete">
        <input type="hidden" asp-for="ID" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index">Back to List</a>
    </form>
</div>
