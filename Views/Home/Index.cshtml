@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>This page is designed to be a Gamemaster's Toolkit.</p>
</div>
<h2 class="display-6">Current Features:</h2>
<ul>
    <li>Oracle Builder — dice tables (d4 through d100) and card tables (52-card deck, tarot)</li>
    <li>Export and import your oracles as a JSON file</li>
</ul>
<h2 class="display-6">In progress Features:</h2>
<ul>
    <li>Rollable oracle tables — roll or draw and read the result</li>
</ul>
<h2 class="display-6">Future Features:</h2>
<ul>
    <li>Character Sheet Storage</li>
    <li>Multi-user accounts</li>
</ul>
