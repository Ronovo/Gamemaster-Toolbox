@model GM_Toolbox.Models.ViewModels.RollPanelModel

@*
    The result of a roll, shared by Oracles/Roll and Flows/Run.

    Children are marked with data-roll attributes rather than ids and are looked up relative to
    the panel root, so a page may host more than one of these. wwwroot/js/roll-panel.js knows
    these attribute names; changing one means changing both files.
*@

<div class="roll-panel" id="@Model.Id">
    <div class="alert alert-warning mb-0" data-roll="error" hidden="@(Model.Error == null)">@Model.Error</div>

    <div data-roll="result" hidden="@(Model.Outcome == null)">
        <div class="small text-muted" data-roll="label" hidden="@string.IsNullOrWhiteSpace(Model.Label)">@Model.Label</div>

        <div class="d-flex flex-wrap align-items-baseline column-gap-3">
            <span class="roll-value" data-roll="value">
                @(Model.Outcome == null ? "" : Model.Outcome.IsDice ? Model.Outcome.Value?.ToString() : Model.Outcome.Key)
            </span>
            <span class="small text-muted" data-roll="caption">@(Model.Outcome?.Caption)</span>
        </div>

        <div class="fs-5 @(Model.Outcome != null && string.IsNullOrWhiteSpace(Model.Outcome.Result) ? "text-muted" : "")" data-roll="text">
            @(Model.Outcome == null ? "" : string.IsNullOrWhiteSpace(Model.Outcome.Result) ? "(no result text)" : Model.Outcome.Result)
        </div>

        <div class="small text-muted" data-roll="reshuffled" hidden="@(Model.Outcome == null || !Model.Outcome.Reshuffled)">
            The deck ran out, so it was reshuffled for this draw.
        </div>
    </div>
</div>
