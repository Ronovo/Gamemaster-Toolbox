<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GM Toolbox</title>
    <script>
        (function () {
            var allowed = { light: 1, dark: 1, cyberpunk: 1, lovecraftian: 1, fantasy: 1 };
            var theme = "dark";
            try { theme = localStorage.getItem("gm-theme") || "dark"; } catch (e) { }
            if (!allowed[theme]) theme = "dark";
            document.documentElement.setAttribute("data-gm-theme", theme);
            document.documentElement.setAttribute("data-bs-theme", theme === "light" ? "light" : "dark");
        })();
    </script>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GM_Toolbox.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark gm-nav mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Gamemaster Toolbox</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">About</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="GameSystems" asp-action="Index">Game Systems</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Oracles" asp-action="Index">Oracles</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Flows" asp-action="Index">Flows</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Sheets" asp-action="Index">Sheets</a>
                            </li>
                        }
                    </ul>
                    <div class="gm-account d-flex flex-column align-items-stretch align-items-sm-end gap-1 py-1">
                        <partial name="_LoginPartial" />
                        <select id="gmTheme" class="form-select form-select-sm gm-theme-picker" aria-label="Color theme">
                            <option value="dark" selected>Dark</option>
                            <option value="light">Light</option>
                            <option value="cyberpunk">Cyberpunk</option>
                            <option value="lovecraftian">Lovecraftian</option>
                            <option value="fantasy">Fantasy</option>
                        </select>
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @if (TempData["OwnershipError"] is string ownershipError)
            {
                <div class="alert alert-danger" role="alert">@ownershipError</div>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            Created September 2026 by Ian Kent - https://github.com/ronovo
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
