@model GM_Toolbox.Models.Oracle
@using GM_Toolbox.Models.Enums
@using GM_Toolbox.Models.ViewModels

@{
    ViewData["Title"] = "Roll";

    var isDice = Model.OracleSubtype.Category() == OracleCategory.Dice;
    var entries = Model.OracleEntries.OrderBy(e => e.SortOrder).ToList();

    var blockedReason = Model.RollBlockedReason();

    var outcome = ViewData["RollOutcome"] as RollOutcome;
    var rollError = ViewData["RollError"] as string;

    var cardsRemaining = ViewData["CardsRemaining"] as int? ?? entries.Count;
    var actionLabel = isDice ? $"Roll {Model.TypeLabel()}" : "Draw a card";
}

<h1>Roll: @Model.Name</h1>

@if (blockedReason != null)
{
    <div class="alert alert-warning">@blockedReason</div>
}
else
{
    <div class="card mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-start">
                <div class="col-12 col-sm-auto d-grid gap-2">
                    <form asp-action="Roll" asp-route-id="@Model.ID" method="post" id="rollForm">
                        <button type="submit" class="btn btn-primary btn-lg w-100">@actionLabel</button>
                    </form>

                    @if (!isDice)
                    {
                        <form asp-action="Reshuffle" asp-route-id="@Model.ID" method="post" id="reshuffleForm">
                            <button type="submit" class="btn btn-outline-secondary w-100">Reshuffle deck</button>
                        </form>
                        <span class="small text-muted text-center">
                            <span id="cardsRemaining">@cardsRemaining</span> cards remaining
                        </span>
                    }
                </div>

                <div class="col">
                    <partial name="_RollPanel" model="@(new RollPanelModel { Id = "rollPanel", Outcome = outcome, Error = rollError })" />
                </div>
            </div>
        </div>
    </div>

    <div id="rollLog" hidden>
        <h4 data-log="heading">Log</h4>
        <hr />
        <table class="table table-sm">
            <thead>
                <tr>
                    <th scope="col" class="roll-log-key">@(isDice ? "Roll" : "Card")</th>
                    <th scope="col">Result</th>
                </tr>
            </thead>
            <tbody data-log="body"></tbody>
        </table>

        <nav class="d-flex align-items-center gap-2" data-log="pager" hidden>
            <button type="button" class="btn btn-sm btn-outline-secondary" data-log="prev">Previous</button>
            <span class="small text-muted" data-log="info"></span>
            <button type="button" class="btn btn-sm btn-outline-secondary" data-log="next">Next</button>
        </nav>
    </div>
}

<div>
    <a asp-action="Details" asp-route-id="@Model.ID">Back to Details</a> |
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    <script src="~/js/roll-panel.js" asp-append-version="true"></script>
    <script>
        (function () {
            var rollForm = document.getElementById("rollForm");
            if (!rollForm) return;

            var panel = GmRoll.panel(document.getElementById("rollPanel"));
            var log = GmRoll.log(document.getElementById("rollLog"), {
                heading: "Log",
                pageSize: 5,
                newestFirst: true,
                limit: 50
            });

            var remainingEl = document.getElementById("cardsRemaining");

            GmRoll.bind(rollForm, {
                onData: function (data) {
                    panel.showOutcome(data);
                    if (remainingEl && typeof data.cardsRemaining === "number") {
                        remainingEl.textContent = data.cardsRemaining;
                    }
                    log.add(data);
                },
                onError: panel.showError
            });

            GmRoll.bind(document.getElementById("reshuffleForm"), {
                onData: function (data) {
                    if (remainingEl) remainingEl.textContent = data.cardsRemaining;
                    panel.clear();
                },
                onError: panel.showError
            });
        })();
    </script>
}
