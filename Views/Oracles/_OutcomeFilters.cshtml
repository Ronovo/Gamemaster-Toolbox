@model GM_Toolbox.Models.ViewModels.OutcomeFilterModel
@using GM_Toolbox.Models.Enums

@{
    var decades = new List<(int Start, int End)>();
    // d10 and smaller are one chunk. Anything past 10 gets another 10-wide jump.
    if (Model.MaxRoll > 10)
    {
        for (int start = 1; start <= Model.MaxRoll; start += 10)
        {
            int end = Math.Min(start + 9, Model.MaxRoll);
            if (end < Model.MinRoll) continue;
            decades.Add((start, end));
        }
    }
}

@if (decades.Count > 1)
{
    <div class="d-flex flex-wrap gap-2 mb-3" role="group" aria-label="Roll range">
        <button type="button" class="btn btn-sm btn-primary" data-filter="decade" data-value="all" aria-pressed="true">All</button>
        @foreach (var decade in decades)
        {
            <button type="button" class="btn btn-sm btn-outline-secondary" data-filter="decade" data-value="@decade.Start-@decade.End" aria-pressed="false">@decade.Start-@decade.End</button>
        }
    </div>
}
else if (Model.OracleSubtype == OracleSubtype.PlayingCards)
{
    <div class="d-flex flex-wrap gap-2 mb-2" role="group" aria-label="Suit">
        <button type="button" class="btn btn-sm btn-primary" data-filter="suit" data-value="all" aria-pressed="true">All</button>
        <button type="button" class="btn btn-sm btn-outline-secondary" data-filter="suit" data-value="H" aria-pressed="false">Hearts</button>
        <button type="button" class="btn btn-sm btn-outline-secondary" data-filter="suit" data-value="D" aria-pressed="false">Diamonds</button>
        <button type="button" class="btn btn-sm btn-outline-secondary" data-filter="suit" data-value="C" aria-pressed="false">Clubs</button>
        <button type="button" class="btn btn-sm btn-outline-secondary" data-filter="suit" data-value="S" aria-pressed="false">Spades</button>
    </div>
    <div class="d-flex flex-wrap gap-2 mb-3" role="group" aria-label="Rank">
        <button type="button" class="btn btn-sm btn-primary" data-filter="rank" data-value="all" aria-pressed="true">All ranks</button>
        <button type="button" class="btn btn-sm btn-outline-secondary" data-filter="rank" data-value="face" aria-pressed="false">Face</button>
        <button type="button" class="btn btn-sm btn-outline-secondary" data-filter="rank" data-value="number" aria-pressed="false">Number</button>
    </div>
}
else if (Model.OracleSubtype == OracleSubtype.TarotCards)
{
    <div class="d-flex flex-wrap gap-2 mb-2" role="group" aria-label="Suit">
        <button type="button" class="btn btn-sm btn-primary" data-filter="suit" data-value="all" aria-pressed="true">All</button>
        <button type="button" class="btn btn-sm btn-outline-secondary" data-filter="suit" data-value="W" aria-pressed="false">Wands</button>
        <button type="button" class="btn btn-sm btn-outline-secondary" data-filter="suit" data-value="C" aria-pressed="false">Cups</button>
        <button type="button" class="btn btn-sm btn-outline-secondary" data-filter="suit" data-value="S" aria-pressed="false">Swords</button>
        <button type="button" class="btn btn-sm btn-outline-secondary" data-filter="suit" data-value="P" aria-pressed="false">Pentacles</button>
    </div>
    <div class="d-flex flex-wrap gap-2 mb-3" role="group" aria-label="Arcana">
        <button type="button" class="btn btn-sm btn-primary" data-filter="rank" data-value="all" aria-pressed="true">All</button>
        <button type="button" class="btn btn-sm btn-outline-secondary" data-filter="rank" data-value="major" aria-pressed="false">Major Arcana</button>
        <button type="button" class="btn btn-sm btn-outline-secondary" data-filter="rank" data-value="number" aria-pressed="false">Minor numbers</button>
        <button type="button" class="btn btn-sm btn-outline-secondary" data-filter="rank" data-value="face" aria-pressed="false">Minor face</button>
    </div>
}
