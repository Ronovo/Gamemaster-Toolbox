@model GM_Toolbox.Models.Oracle
@using GM_Toolbox.Models.Enums

@{
    ViewData["Title"] = "Configure";
    var returnTo = ViewData["ReturnTo"] as string;
}

<h1>Configure: @Model.Name</h1>

@switch (Model.OracleSubtype.Category())
{
    case OracleCategory.Dice:
        {
            var outcomeCount = Model.OracleEntries.Count;
            var spec = Model.Dice();

            if (spec == null)
            {
                <div class="alert alert-warning">
                    This oracle's dice haven't been set.
                    <a asp-action="Edit" asp-route-id="@Model.ID">Set them</a> before choosing outcomes.
                </div>
            }
            else
            {
                if (spec.Count > 1)
                {
                    <p>
                        This is a @spec.Label oracle. Totals run @spec.Min to @spec.Max,
                        so you can have up to @spec.Span outcomes. How many do you want?
                    </p>
                }
                else
                {
                    <p>
                        This is a @spec.Label oracle. How many outcomes do you want on the table?
                        New rows start numbered 1, 2, 3&hellip; so a table of three is already filled in.
                    </p>
                }

                if (outcomeCount > 0)
                {
                    <p class="text-muted">
                        This oracle currently has @outcomeCount outcomes. Changing the number
                        keeps the text you've already entered where the rows line up
                    </p>
                }

                <form asp-action="Configure" asp-route-id="@Model.ID" asp-route-returnTo="@returnTo" method="post">
                    <div asp-validation-summary="All" class="text-danger"></div>

                    <div class="row">
                        <div class="col-md-2">
                            <label for="outcomeCount">Number of outcomes</label>
                            <input type="text" inputmode="numeric" id="outcomeCount" name="outcomeCount"
                                   class="form-control"
                                   value="@(outcomeCount > 0 ? outcomeCount.ToString() : spec.Span.ToString())" />
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary">Create outcomes</button>
                </form>
            }
        }
    break;
 
    case OracleCategory.Cards:
        <p>
            This builds the full deck with each card's name already filled in as the outcome.
            You can change those names later, a few at a time.
        </p>

        <form asp-action="Configure" asp-route-id="@Model.ID" asp-route-returnTo="@returnTo" method="post">
            <button type="submit" class="btn btn-primary">Generate deck</button>
        </form>
    break;
}

<p>
    @if (returnTo == "Index")
    {
        <a asp-action="Index">Cancel</a>
    }
    else
    {
        <a asp-action="Details" asp-route-id="@Model.ID">Cancel</a>
    }
</p>