@model GM_Toolbox.Models.Oracle
@using GM_Toolbox.Models.Enums
@using GM_Toolbox.Models.ViewModels
@using GM_Toolbox.Services

@{
    ViewData["Title"] = "Details";

    var isDice = Model.OracleSubtype.Category() == OracleCategory.Dice;
    var entries = Model.OracleEntries.OrderBy(e => e.SortOrder).ToList();

    var blockedReason = Model.RollBlockedReason();

    var spec = Model.Dice();
    var pageSize = isDice ? 10 : 15;
    var filter = new OutcomeFilterModel
    {
        OracleSubtype = Model.OracleSubtype,
        DiceCount = spec?.Count ?? 0,
        DiceFaces = spec?.Faces ?? 0,
        MinRoll = spec?.Min ?? 0,
        MaxRoll = spec?.Max ?? 0,
    };
}

<h1>@Model.Name</h1>

@if (blockedReason != null)
{
    <div class="alert alert-warning">@blockedReason</div>
}

<div>
    <h4>Oracle</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.OracleSubtype)
        </dt>
        <dd class="col-sm-10">
            @Model.TypeLabel()
        </dd>
        <dt class="col-sm-2">
            Game System
        </dt>
        <dd class="col-sm-10">
            @Model.GameSystem?.Name
        </dd>
    </dl>
</div>

@if (entries.Count > 0)
{
    <details class="outcome-list mb-3">
        <summary class="mb-2">
            <span class="summary-show">Show</span><span class="summary-hide">Hide</span>
            all @entries.Count @(isDice ? "outcomes" : "cards")
        </summary>
        <div data-outcome-pager data-page-size="@pageSize">
            <partial name="_OutcomeFilters" model="filter" />
            <table class="table" id="outcomeTable">
                <thead>
                    <tr>
                        <th>@(isDice ? "Roll" : "Card")</th>
                        <th>Result</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in entries)
                    {
                        var classified = DeckFactory.Classify(entry.CardCode);
                        <tr data-entry-row
                            data-starts-at="@(entry.RangeStart ?? 0)"
                            data-suit="@classified?.Suit"
                            data-rank-kind="@classified?.RankKind">
                            <td>@entry.KeyLabel()</td>
                            <td>@entry.Result</td>
                        </tr>
                    }
                </tbody>
            </table>

            <nav data-outcome-pager-nav class="d-flex align-items-center gap-2" hidden>
                <button type="button" data-outcome-prev class="btn btn-sm btn-outline-secondary">Previous</button>
                <span data-outcome-page-info class="small text-muted"></span>
                <button type="button" data-outcome-next class="btn btn-sm btn-outline-secondary">Next</button>
            </nav>
        </div>
    </details>
}

@if (blockedReason == null)
{
    <p>
        <a asp-action="Roll" asp-route-id="@Model.ID" class="btn btn-primary">Roll this oracle</a>
    </p>
}

<div>
    <a asp-action="Configure" asp-route-id="@Model?.ID">Configure</a> |
    <a asp-action="Edit" asp-route-id="@Model?.ID">Edit</a> |
    <a asp-action="Delete" asp-route-id="@Model?.ID">Delete</a> |
    <a asp-action="Index">Back to List</a>
</div>
