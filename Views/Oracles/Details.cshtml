@model GM_Toolbox.Models.Oracle
@using GM_Toolbox.Models.Enums

@{
    ViewData["Title"] = "Details";

    var isDice = Model.OracleSubtype.Category() == OracleCategory.Dice;
    var entries = Model.OracleEntries.OrderBy(e => e.SortOrder).ToList();
    var missingBands = isDice && entries.Any(e => e.RangeStart == null);
}

<h1>@Model.Name</h1>

<div>
    <h4>Oracle</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.OracleSubtype)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.OracleSubtype)
        </dd>
        <dt class="col-sm-2">
            Game System
        </dt>
        <dd class="col-sm-10">
            @Model.GameSystem?.Name
        </dd>
    </dl>
</div>
<div>
    <h4>Outcomes</h4>
    <hr />

    @if (entries.Count == 0)
    {
        <p class="text-muted">This oracle has no outcomes yet. Use Configure to create them.</p>
    }
    else
    {
        @if (missingBands)
        {
            <div class="alert alert-warning">
                The roll ranges haven't been set yet. Use Configure to finish this oracle.
            </div>
        }

        <table class="table">
            <thead>
                <tr>
                    <th>@(isDice ? "Roll" : "Card")</th>
                    <th>Result</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var entry in entries)
                {
                    <tr>
                        <td>@entry.KeyLabel()</td>
                        <td>@entry.Result</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
<div>
    <a asp-action="Configure" asp-route-id="@Model?.ID">Configure</a> |
    <a asp-action="Edit" asp-route-id="@Model?.ID">Edit</a> |
    <a asp-action="Delete" asp-route-id="@Model?.ID">Delete</a> |
    <a asp-action="Index">Back to List</a>
</div>
