@using GM_Toolbox.Models.ViewModels

@model ExportViewModel

@{
    ViewData["Title"] = "Export";
    var backController = Model.ReturnTo == "Flows" || Model.ReturnTo == "GameSystems"
        ? Model.ReturnTo
        : "Oracles";
}

<h1>Export</h1>

@if (Model.CatalogEmpty)
{
    <p class="text-muted">
        Nothing to export yet. Add a game system, then build an oracle or a flow.
    </p>

    <div>
        <a asp-controller="@backController" asp-action="Index">Back to List</a>
    </div>
}
else
{
    <p class="text-muted">
        Downloads a portable JSON file. It carries no database IDs, so it imports cleanly
        into any other instance of the toolbox. Game systems travel with their genre; if
        the destination already has that system by name, it keeps the one it has.
    </p>

    <form asp-action="Export" method="post">
        <input type="hidden" asp-for="ReturnTo" />
        <div asp-validation-summary="All" class="text-danger"></div>

        <div id="oracle-selected">
            @foreach (var id in Model.SelectedIds)
            {
                <input type="hidden" name="SelectedIds" value="@id" />
            }
        </div>
        <div id="flow-selected">
            @foreach (var id in Model.SelectedFlowIds)
            {
                <input type="hidden" name="SelectedFlowIds" value="@id" />
            }
        </div>

        <div class="form-check">
            <input class="form-check-input" type="radio" name="Scope" id="scopeEverything"
                   value="@ExportScope.Everything" checked="@(Model.Scope == ExportScope.Everything)" />
            <label class="form-check-label" for="scopeEverything">
                Export everything
                <span class="text-muted">
                    (@Model.GameSystemCount game system(s), @Model.OracleCount oracle(s),
                    @Model.FlowCount flow(s))
                </span>
            </label>
        </div>

        <div class="form-check mt-2">
            <input class="form-check-input" type="radio" name="Scope" id="scopeAllOracles"
                   value="@ExportScope.AllOracles" checked="@(Model.Scope == ExportScope.AllOracles)" />
            <label class="form-check-label" for="scopeAllOracles">
                All oracles
                <span class="text-muted">(@Model.OracleCount oracle(s), no flows)</span>
            </label>
        </div>

        <div class="form-check mt-2">
            <input class="form-check-input" type="radio" name="Scope" id="scopeSelectedOracles"
                   value="@ExportScope.SelectedOracles" checked="@(Model.Scope == ExportScope.SelectedOracles)" />
            <label class="form-check-label" for="scopeSelectedOracles">
                Choose oracles
            </label>
        </div>

        <fieldset id="oraclePicker" class="mt-3 ms-4">
            @if (Model.OracleCount == 0)
            {
                <p class="text-muted">No oracles yet.</p>
            }
            else
            {
                <p class="mb-2" id="oraclePickerLinks">
                    <a href="#" id="selectAllOracles"
                       data-ids-url="@Url.Action("ExportOracleIds")"
                       data-filter-root="#oracle-filters">Select all</a> |
                    <a href="#" id="selectNoneOracles"
                       data-ids-url="@Url.Action("ExportOracleIds")"
                       data-filter-root="#oracle-filters">Select none</a>
                </p>

                <div id="oracle-filters" class="mb-3"
                     data-live-filter
                     data-action="@Url.Action("Export")"
                     data-results="#oracle-picker-results"
                     data-partial="oracles"
                     data-page-param="OraclePage">
                    <input type="hidden" name="returnTo" value="@Model.ReturnTo" />
                    <div class="row g-2 align-items-end">
                        <div class="col-md-4">
                            <label class="form-label" for="OracleName">Name</label>
                            <input asp-for="OracleName" class="form-control" autocomplete="off" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label" asp-for="OracleType"></label>
                            <select asp-for="OracleType" class="form-select">
                                @foreach (var item in Model.Subtypes)
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label" asp-for="OracleGameSystemID"></label>
                            <select asp-for="OracleGameSystemID" class="form-select">
                                @foreach (var item in Model.GameSystems)
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>

                <div id="oracle-picker-results">
                    <partial name="_ExportOraclePicker" model="Model" />
                </div>
            }
        </fieldset>

        <div class="form-check mt-2">
            <input class="form-check-input" type="radio" name="Scope" id="scopeSelectedFlows"
                   value="@ExportScope.SelectedFlows" checked="@(Model.Scope == ExportScope.SelectedFlows)" />
            <label class="form-check-label" for="scopeSelectedFlows">
                Choose flows
            </label>
        </div>

        <fieldset id="flowPicker" class="mt-3 ms-4">
            @if (Model.FlowCount == 0)
            {
                <p class="text-muted">No flows yet.</p>
            }
            else
            {
                <p class="text-muted small">
                    A flow always travels with the oracles it rolls, and only those.
                </p>
                <p class="mb-2" id="flowPickerLinks">
                    <a href="#" id="selectAllFlows"
                       data-ids-url="@Url.Action("ExportFlowIds")"
                       data-filter-root="#flow-filters">Select all</a> |
                    <a href="#" id="selectNoneFlows"
                       data-ids-url="@Url.Action("ExportFlowIds")"
                       data-filter-root="#flow-filters">Select none</a>
                </p>

                <div id="flow-filters" class="mb-3"
                     data-live-filter
                     data-action="@Url.Action("Export")"
                     data-results="#flow-picker-results"
                     data-partial="flows"
                     data-page-param="FlowPage">
                    <input type="hidden" name="returnTo" value="@Model.ReturnTo" />
                    <div class="row g-2 align-items-end">
                        <div class="col-md-4">
                            <label class="form-label" for="FlowName">Name</label>
                            <input asp-for="FlowName" class="form-control" autocomplete="off" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" asp-for="FlowGameSystemID"></label>
                            <select asp-for="FlowGameSystemID" class="form-select">
                                @foreach (var item in Model.GameSystems)
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>

                <div id="flow-picker-results">
                    <partial name="_ExportFlowPicker" model="Model" />
                </div>
            }
        </fieldset>

        <button type="submit" class="btn btn-primary">Export</button>
        <a asp-controller="@backController" asp-action="Index" class="btn btn-link">Back to List</a>
    </form>
}
