@using GM_Toolbox.Models.ViewModels

@model ExportViewModel

@{
    ViewData["Title"] = "Export";
    var backController = Model.ReturnTo == "Flows" || Model.ReturnTo == "GameSystems"
        ? Model.ReturnTo
        : "Oracles";
}

<h1>Export</h1>

@if (Model.GameSystemCount == 0 && !Model.Available.Any() && !Model.AvailableFlows.Any())
{
    <p class="text-muted">
        Nothing to export yet. Add a game system, then build an oracle or a flow.
    </p>

    <div>
        <a asp-controller="@backController" asp-action="Index">Back to List</a>
    </div>
}
else
{
    <p class="text-muted">
        Downloads a portable JSON file. It carries no database IDs, so it imports cleanly
        into any other instance of the toolbox. Game systems travel with their genre; if
        the destination already has that system by name, it keeps the one it has.
    </p>

    <form asp-action="Export" method="post">
        <input type="hidden" asp-for="ReturnTo" />
        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="form-check">
            <input class="form-check-input" type="radio" name="Scope" id="scopeEverything"
                   value="@ExportScope.Everything" checked="@(Model.Scope == ExportScope.Everything)" />
            <label class="form-check-label" for="scopeEverything">
                Export everything
                <span class="text-muted">
                    (@Model.GameSystemCount game system(s), @Model.Available.Count oracle(s),
                    @Model.AvailableFlows.Count flow(s))
                </span>
            </label>
        </div>

        <div class="form-check mt-2">
            <input class="form-check-input" type="radio" name="Scope" id="scopeAllOracles"
                   value="@ExportScope.AllOracles" checked="@(Model.Scope == ExportScope.AllOracles)" />
            <label class="form-check-label" for="scopeAllOracles">
                All oracles
                <span class="text-muted">(@Model.Available.Count oracle(s), no flows)</span>
            </label>
        </div>

        <div class="form-check mt-2">
            <input class="form-check-input" type="radio" name="Scope" id="scopeSelectedOracles"
                   value="@ExportScope.SelectedOracles" checked="@(Model.Scope == ExportScope.SelectedOracles)" />
            <label class="form-check-label" for="scopeSelectedOracles">
                Choose oracles
            </label>
        </div>

        <fieldset id="oraclePicker" class="mt-3 ms-4">
            @if (!Model.Available.Any())
            {
                <p class="text-muted">No oracles yet.</p>
            }
            else
            {
                <p class="mb-2" id="oraclePickerLinks">
                    <a href="#" id="selectAllOracles">Select all</a> |
                    <a href="#" id="selectNoneOracles">Select none</a>
                </p>

                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Name</th>
                            <th>Oracle Type</th>
                            <th>Game System</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Available)
                        {
                            <tr>
                                <td>
                                    <input class="form-check-input oracle-pick" type="checkbox"
                                           name="SelectedIds" value="@item.ID"
                                           id="oracle-@item.ID"
                                           checked="@Model.SelectedIds.Contains(item.ID)" />
                                </td>
                                <td>
                                    <label class="form-check-label" for="oracle-@item.ID">@item.Name</label>
                                    @if (item.NeedsSetup)
                                    {
                                        <span class="badge bg-warning text-dark">Needs setup</span>
                                    }
                                </td>
                                <td>@Html.DisplayFor(m => item.OracleSubtype)</td>
                                <td>@item.GameSystemName</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </fieldset>

        <div class="form-check mt-2">
            <input class="form-check-input" type="radio" name="Scope" id="scopeSelectedFlows"
                   value="@ExportScope.SelectedFlows" checked="@(Model.Scope == ExportScope.SelectedFlows)" />
            <label class="form-check-label" for="scopeSelectedFlows">
                Choose flows
            </label>
        </div>

        <fieldset id="flowPicker" class="mt-3 ms-4">
            @if (!Model.AvailableFlows.Any())
            {
                <p class="text-muted">No flows yet.</p>
            }
            else
            {
                <p class="text-muted small">
                    A flow always travels with the oracles it rolls, and only those.
                </p>
                <p class="mb-2" id="flowPickerLinks">
                    <a href="#" id="selectAllFlows">Select all</a> |
                    <a href="#" id="selectNoneFlows">Select none</a>
                </p>
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Name</th>
                            <th>Steps</th>
                            <th>Game System</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var flow in Model.AvailableFlows)
                        {
                            <tr>
                                <td>
                                    <input class="form-check-input flow-pick" type="checkbox"
                                           name="SelectedFlowIds" value="@flow.ID"
                                           id="flow-@flow.ID"
                                           checked="@Model.SelectedFlowIds.Contains(flow.ID)" />
                                </td>
                                <td>
                                    <label class="form-check-label" for="flow-@flow.ID">@flow.Name</label>
                                    @if (flow.NeedsSetup)
                                    {
                                        <span class="badge bg-warning text-dark">Needs setup</span>
                                    }
                                </td>
                                <td>@flow.StepCount</td>
                                <td>@flow.GameSystemName</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </fieldset>

        <button type="submit" class="btn btn-primary">Export</button>
        <a asp-controller="@backController" asp-action="Index" class="btn btn-link">Back to List</a>
    </form>
}

@section Scripts {
    <script>
        (function () {
            var oraclePicker = document.getElementById('oraclePicker');
            var flowPicker = document.getElementById('flowPicker');
            if (!oraclePicker || !flowPicker) return;

            var selectedOracles = document.getElementById('scopeSelectedOracles');
            var selectedFlows = document.getElementById('scopeSelectedFlows');

            function setEnabled(box, on) {
                box.disabled = !on;
                box.style.opacity = on ? '1' : '0.5';
            }

            function sync() {
                setEnabled(oraclePicker, selectedOracles.checked);
                setEnabled(flowPicker, selectedFlows.checked);
            }

            function setAll(selector, value) {
                document.querySelectorAll(selector).forEach(function (box) {
                    box.checked = value;
                });
            }

            document.getElementsByName('Scope').forEach(function (radio) {
                radio.addEventListener('change', sync);
            });

            var allOracles = document.getElementById('selectAllOracles');
            var noneOracles = document.getElementById('selectNoneOracles');
            var allFlows = document.getElementById('selectAllFlows');
            var noneFlows = document.getElementById('selectNoneFlows');

            if (allOracles) allOracles.addEventListener('click', function (e) {
                e.preventDefault();
                setAll('.oracle-pick', true);
            });
            if (noneOracles) noneOracles.addEventListener('click', function (e) {
                e.preventDefault();
                setAll('.oracle-pick', false);
            });
            if (allFlows) allFlows.addEventListener('click', function (e) {
                e.preventDefault();
                setAll('.flow-pick', true);
            });
            if (noneFlows) noneFlows.addEventListener('click', function (e) {
                e.preventDefault();
                setAll('.flow-pick', false);
            });

            sync();
        })();
    </script>
}
