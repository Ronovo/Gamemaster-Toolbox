@using GM_Toolbox.Models.ViewModels
@model OracleIndexViewModel

@{
    ViewData["Title"] = "Oracles";
}

<h1>Your Oracles</h1>
@if (TempData["ImportMessage"] != null)
{
    <div class="alert alert-success">@TempData["ImportMessage"]</div>
}
<p>
    <a asp-action="Create">Create New</a>
    <a asp-action="Export">Export</a>
    <a asp-action="Import">Import</a>
    <a asp-action="ClearAll" class="text-danger">Clear All</a>
</p>

@if (!Model.CatalogEmpty)
{
    <form method="get" asp-action="Index" class="mb-3" data-live-filter data-results="#list-results" data-partial="1">
        <div class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label" asp-for="Name"></label>
                <input asp-for="Name" class="form-control" autocomplete="off" />
            </div>
            <div class="col-md-3">
                <label class="form-label" asp-for="OracleType"></label>
                <select asp-for="OracleType" class="form-select">
                    @foreach (var item in Model.Subtypes)
                    {
                        <option value="@item.Value">@item.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label" asp-for="GameSystemID"></label>
                <select asp-for="GameSystemID" class="form-select">
                    @foreach (var item in Model.GameSystems)
                    {
                        <option value="@item.Value">@item.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-outline-secondary">Filter</button>
            </div>
        </div>
    </form>
}

<div id="list-results">
    <partial name="_OracleListResults" model="Model" />
</div>
