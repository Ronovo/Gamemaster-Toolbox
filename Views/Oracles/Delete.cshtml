@model GM_Toolbox.Models.Oracle

@{
    ViewData["Title"] = "Delete";
    var usedByFlows = ViewData["UsedByFlows"] as List<string> ?? new List<string>();
}

<h1>Delete Oracle</h1>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Oracle</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.OracleSubtype)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.OracleSubtype)
        </dd>
    </dl>
    <dl class="row">
        <dt class="col-sm-2">
            Game System
        </dt>
        <dd class="col-sm-10">
            @Model.GameSystem?.Name
        </dd>
    </dl>
    @if (usedByFlows.Any())
    {
        <div class="alert alert-warning">
            This oracle is used by @string.Join(", ", usedByFlows) &mdash; as a step, or as an
            option on one of its questions. Change or remove those, or delete the flows, before
            deleting the oracle.
        </div>
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    }
    else
    {
        <form asp-action="Delete">
            <input type="hidden" asp-for="ID" />
            <input type="submit" value="Delete" class="btn btn-danger" /> |
            <a asp-action="Index">Back to List</a>
        </form>
    }
</div>
