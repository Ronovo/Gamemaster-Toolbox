@{
    ViewData["Title"] = "Import";
    var returnTo = ViewData["ReturnTo"] as string;
    var backController = returnTo == "Flows" || returnTo == "GameSystems" ? returnTo : "Oracles";
}

<h1>Import</h1>

<p class="text-muted">
    Adds what is in the file to what you already have — it never merges or replaces oracles
    or flows. Importing the same file twice gives you two copies of those. A game system
    whose name you already have is reused as-is, including its genre; a new name is created
    from the file. Use Clear All first if you want a clean slate for oracles and flows.
</p>

<form asp-action="Import" method="post" enctype="multipart/form-data">
    <input type="hidden" name="returnTo" value="@returnTo" />
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="form-group mb-3">
        <label for="file" class="control-label">Export file (.json)</label>
        <input type="file" id="file" name="file" accept=".json,application/json" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Import</button>
    <a asp-controller="@backController" asp-action="Index" class="btn btn-link">Cancel</a>
</form>
