@model GM_Toolbox.Models.ViewModels.ImportViewModel
@{
    ViewData["Title"] = "Import";
    var backController = Model.ReturnTo == "Flows" || Model.ReturnTo == "GameSystems" ? Model.ReturnTo : "Oracles";
}

<h1>Import</h1>

<p class="text-muted">
    Adds what is in the file to what you already have. It never merges or replaces oracles
    or flows, so importing the same file twice gives you two copies of those. A game system
    whose name you already have is reused as-is, including its genre; a new name is created
    from the file. Use Clear All first if you want a clean slate for oracles and flows.
</p>

<p class="text-muted">
    Pick an export file from your computer: one you downloaded with Export, or one another
    gamemaster sent you. Not sure what one looks like?
    <a asp-action="ExampleFile">Download an example file</a> and import that.
</p>

<div asp-validation-summary="All" class="text-danger"></div>

<form asp-action="Import" method="post" enctype="multipart/form-data">
    <input type="hidden" name="returnTo" value="@Model.ReturnTo" />
    <div class="mb-3">
        <input type="file" name="file" accept=".json,application/json" class="form-control" required />
        <div class="form-text">A .json export file, up to 5 MB.</div>
    </div>
    <button type="submit" class="btn btn-primary">Import</button>
    <a asp-controller="@backController" asp-action="Index" class="ms-2">Cancel</a>
</form>
