@model GM_Toolbox.Models.ViewModels.EditEntriesViewModel

@{
    ViewData["Title"] = "Edit Entries";
    var pageSize = Model.IsDice ? 10 : 15;
}

<h1>Outcomes: @Model.Name</h1>

<form asp-action="EditEntries" method="post" id="editEntriesForm" data-outcome-pager data-page-size="@pageSize">
    <input type="hidden" asp-for="OracleID" />

    <div asp-validation-summary="All" class="text-danger"></div>

    <partial name="_OutcomeFilters" model="Model.Filter()" />

    @for (int i = 0; i < Model.Rows.Count; i++)
    {
        <div class="entry-row form-group mb-3"
             data-entry-row
             data-starts-at="@Model.Rows[i].StartsAt"
             data-suit="@Model.Rows[i].Suit"
             data-rank-kind="@Model.Rows[i].RankKind">
            <input type="hidden" asp-for="Rows[i].EntryId" />

            <label asp-for="Rows[i].Result">@Model.Rows[i].Label</label>

            @if (Model.IsDice)
            {
                <label asp-for="Rows[i].StartsAt">Roll Starts at</label>
                <div class="row">
                    <div class="col-md-2">
                        <input asp-for="Rows[i].StartsAt" type="text" inputmode="numeric"
                            class="form-control"
                            readonly="@(i == 0)" />
                    </div>
                </div>
            }
            <input asp-for="Rows[i].Result" class="form-control mt-2" />
        </div>
    }

    <nav data-outcome-pager-nav class="d-flex align-items-center gap-2 mb-3" hidden>
        <button type="button" data-outcome-prev class="btn btn-sm btn-outline-secondary">Previous</button>
        <span data-outcome-page-info class="small text-muted"></span>
        <button type="button" data-outcome-next class="btn btn-sm btn-outline-secondary">Next</button>
    </nav>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Details" asp-route-id="@Model.OracleID" class="btn btn-link">Cancel</a>
</form>
