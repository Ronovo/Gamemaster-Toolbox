@model GM_Toolbox.Models.ViewModels.ClearAllViewModel

@{
    ViewData["Title"] = "Clear All";
}

<h1>Clear All Your Oracles and Flows</h1>

<div class="alert alert-danger">
    <p>
        This permanently deletes your <strong>@Model.OracleCount</strong> oracle(s)
        and <strong>@Model.EntryCount</strong> entries. It cannot be undone.
    </p>
    @if (Model.FlowCount > 0)
    {
        <p>
            It also deletes <strong>@Model.FlowCount</strong> flow(s) and their
            <strong>@Model.FlowStepCount</strong> step(s). A flow is nothing but an order to
            roll oracles in, so none of them would survive this anyway.
        </p>
    }
    <p class="mb-0">Export first if you want a copy you can import back.</p>
</div>

<a asp-action="Export" class="btn btn-secondary">Export All First</a>

<form asp-action="ClearAll" method="post" class="d-inline">
    <button type="submit" class="btn btn-danger">Delete All of Mine</button>
</form>

<a asp-action="Index" class="btn btn-link">Cancel</a>