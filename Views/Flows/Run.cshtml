@model GM_Toolbox.Models.Flow
@using GM_Toolbox.Models.ViewModels
@using GM_Toolbox.Models.Enums
@using System.Text.Json

@{
    ViewData["Title"] = "Run";

    var state = ViewData["RunState"] as FlowRunState ?? new FlowRunState { FlowID = Model.ID };
    var runError = ViewData["RunError"] as string;
    var blockedReason = Model.RunBlockedReason();

    var currentStep = Model.Steps.FirstOrDefault(s => s.ID == state.CurrentStepID);
    var lastRolled = state.Transcript.LastOrDefault();

    var controlLabel = currentStep?.ControlLabel() ?? "Roll";
    var currentKind = currentStep?.Kind ?? FlowStepKind.Roll;

    // Seeds the log component with the run so far, so a page that has JavaScript ends up with
    // exactly the rows the server already rendered rather than wiping them on first render.
    var seed = JsonSerializer.Serialize(state.Transcript.Select(t => new
    {
        label = t.Label,
        isDice = t.Outcome.IsDice,
        value = t.Outcome.Value,
        key = t.Outcome.Key,
        caption = t.Outcome.Caption,
        result = t.Outcome.Result,
        outcomes = t.Outcomes
    }), new JsonSerializerOptions(JsonSerializerDefaults.Web));
}

<h1>Run: @Model.Name</h1>

@if (blockedReason != null)
{
    <div class="alert alert-warning">@blockedReason</div>
}
else
{
    <div class="card mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-start">
                <div class="col-12 col-sm-auto d-grid gap-2" style="min-width: 16rem;">
                    @* One form for every kind of step. What sits inside it changes: a button on
                       its own for a roll, a dropdown or a field plus a button for a question.
                       The server renders whichever the current step needs, so this works with
                       scripting off; with scripting on the page script rewrites it in place. *@
                    <form asp-action="Run" asp-route-id="@Model.ID" method="post" id="runForm"
                          hidden="@state.Finished">

                        <div id="runQuestion" hidden="@(!currentKind.IsQuestion())">
                            <label class="form-label small" for="runAnswer" id="runQuestionText">
                                @currentStep?.Prompt(Model)
                            </label>

                            @* Disabled as well as hidden: both controls are named "answer",
                               and a hidden-but-enabled one still posts its value. *@
                            <select name="answer" class="form-control mb-2" id="runAnswerSelect"
                                    hidden="@(currentKind != FlowStepKind.Choice)"
                                    disabled="@(currentKind != FlowStepKind.Choice)">
                                @if (currentStep != null && currentKind == FlowStepKind.Choice)
                                {
                                    foreach (var option in currentStep.Options.OrderBy(o => o.SortOrder))
                                    {
                                        <option value="@option.ID">@option.Label</option>
                                    }
                                }
                            </select>

                            <input name="answer" class="form-control mb-2" id="runAnswerInput"
                                   type="text"
                                   hidden="@(currentKind != FlowStepKind.Text)"
                                   disabled="@(currentKind != FlowStepKind.Text)" />

                            <input name="answer" class="form-control mb-2" id="runAnswerNumber"
                                   type="number" min="1" max="@GM_Toolbox.Services.FlowRunner.LoopLimit"
                                   step="1" inputmode="numeric" required
                                   hidden="@(currentKind != FlowStepKind.Loop)"
                                   disabled="@(currentKind != FlowStepKind.Loop)" />
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100" id="runButton">@controlLabel</button>
                    </form>

                    <form asp-action="Restart" asp-route-id="@Model.ID" method="post" id="restartForm">
                        <button type="submit" class="btn btn-outline-secondary w-100">Start over</button>
                    </form>

                    <span class="small text-muted text-center" id="runFinished" hidden="@(!state.Finished)">
                        This run has finished.
                    </span>
                </div>

                <div class="col">
                    <partial name="_RollPanel" model="@(new RollPanelModel {
                        Id = "runPanel",
                        Outcome = lastRolled?.Outcome,
                        Outcomes = lastRolled?.Outcomes,
                        Error = runError,
                        Label = lastRolled?.Label })" />
                </div>
            </div>

            <div class="alert alert-warning mt-3 mb-0" id="runStepLimit" hidden="@(!state.HitStepLimit)">
                This run reached @GM_Toolbox.Services.FlowRunner.StepLimit steps and was stopped there.
                A branch pointing back up the flow can keep it going forever.
            </div>
        </div>
    </div>

    <div id="runLog" hidden="@(!state.Transcript.Any())">
        <h4 data-log="heading">Run so far</h4>
        <hr />
        <table class="table table-sm roll-log">
            <thead>
                <tr>
                    <th scope="col" class="roll-log-step">Step</th>
                    <th scope="col" class="roll-log-result">Result</th>
                    <th scope="col" class="roll-log-notes">Notes</th>
                </tr>
            </thead>
            <tbody data-log="body">
                @foreach (var entry in state.Transcript)
                {
                    <tr>
                        <td>@entry.Label</td>
                        @if (entry.Outcomes.Count > 1)
                        {
                            <td colspan="2">
                                <ol class="mb-0 ps-3">
                                    @foreach (var item in entry.Outcomes)
                                    {
                                        <li>
                                            <strong>@(item.IsDice ? item.Value?.ToString() : item.Key)</strong>
                                            @if (!string.IsNullOrEmpty(item.Caption))
                                            {
                                                <span class="small text-muted ms-1">@item.Caption</span>
                                            }
                                            <span class="ms-1 @(string.IsNullOrWhiteSpace(item.Result) ? "text-muted" : "")">
                                                @(string.IsNullOrWhiteSpace(item.Result) ? "(no result text)" : item.Result)
                                            </span>
                                        </li>
                                    }
                                </ol>
                            </td>
                        }
                        else
                        {
                            <td>
                                <strong>@(entry.Outcome.IsDice ? entry.Outcome.Value?.ToString() : entry.Outcome.Key)</strong>
                                @if (!string.IsNullOrEmpty(entry.Outcome.Caption))
                                {
                                    <div class="small text-muted">@entry.Outcome.Caption</div>
                                }
                            </td>
                            <td class="@(string.IsNullOrWhiteSpace(entry.Outcome.Result) ? "text-muted" : "")">
                                @(string.IsNullOrWhiteSpace(entry.Outcome.Result) ? "(no result text)" : entry.Outcome.Result)
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>

        <nav class="d-flex align-items-center gap-2" data-log="pager" hidden>
            <button type="button" class="btn btn-sm btn-outline-secondary" data-log="prev">Previous</button>
            <span class="small text-muted" data-log="info"></span>
            <button type="button" class="btn btn-sm btn-outline-secondary" data-log="next">Next</button>
        </nav>
    </div>

    <script type="application/json" id="runSeed">@Html.Raw(seed)</script>
}

<div>
    <a asp-action="Details" asp-route-id="@Model.ID">Back to Details</a> |
    <a asp-action="Steps" asp-route-id="@Model.ID">Steps</a> |
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    <script src="~/js/roll-panel.js" asp-append-version="true"></script>
    <script>
        (function () {
            var runForm = document.getElementById("runForm");
            if (!runForm) return;

            var panel = GmRoll.panel(document.getElementById("runPanel"));
            var log = GmRoll.log(document.getElementById("runLog"), {
                heading: "Run so far",
                pageSize: 10,
                newestFirst: false,
                showLabel: true,
                limit: 100
            });

            var button = document.getElementById("runButton");
            var finishedEl = document.getElementById("runFinished");
            var stepLimitEl = document.getElementById("runStepLimit");
            var restartForm = document.getElementById("restartForm");

            var questionWrap = document.getElementById("runQuestion");
            var questionText = document.getElementById("runQuestionText");
            var answerSelect = document.getElementById("runAnswerSelect");
            var answerInput = document.getElementById("runAnswerInput");
            var answerNumber = document.getElementById("runAnswerNumber");

            // Re-render the server's rows through the component so both paths agree, and so the
            // pager works on a run that was resumed after a refresh.
            var seedEl = document.getElementById("runSeed");
            if (seedEl) {
                try {
                    JSON.parse(seedEl.textContent).forEach(log.add);
                } catch (e) {
                }
            }

            // Both answer controls are named "answer", so only the one this kind of step uses
            // may be enabled -- a disabled control is not submitted.
            function setControl(next, finished) {
                runForm.hidden = finished;
                finishedEl.hidden = !finished;
                if (finished || !next) return;

                button.textContent = next.buttonLabel;
                questionWrap.hidden = !next.isQuestion;
                questionText.textContent = next.question || "";

                var isChoice = next.kind === "Choice";
                var isTyped = next.kind === "Text";

                answerSelect.hidden = !isChoice;
                answerSelect.disabled = !isChoice;
                if (isChoice) {
                    answerSelect.textContent = "";
                    for (var i = 0; i < next.options.length; i++) {
                        var opt = document.createElement("option");
                        opt.value = next.options[i].id;
                        opt.textContent = next.options[i].label;
                        answerSelect.appendChild(opt);
                    }
                }

                answerInput.hidden = !isTyped;
                answerInput.disabled = !isTyped;
                answerInput.value = "";

                var isLoop = next.kind === "Loop";
                answerNumber.hidden = !isLoop;
                answerNumber.disabled = !isLoop;
                answerNumber.value = "";
            }

            GmRoll.bind(runForm, {
                onData: function (data) {
                    panel.showOutcome(data.outcome, data.label, data.outcomes);
                    log.add({
                        label: data.label,
                        isDice: data.outcome.isDice,
                        value: data.outcome.value,
                        key: data.outcome.key,
                        caption: data.outcome.caption,
                        result: data.outcome.result,
                        outcomes: data.outcomes
                    });
                    stepLimitEl.hidden = !data.hitStepLimit;
                    setControl(data.next, data.finished);
                },
                onError: panel.showError
            });

            GmRoll.bind(restartForm, {
                onData: function (data) {
                    log.reset();
                    panel.clear();
                    stepLimitEl.hidden = true;
                    setControl(data.next, data.finished);
                },
                onError: panel.showError
            });

            // The server rendered the first control already; make sure the disabled flags match
            // it, since a hidden-but-enabled field would still post its empty value.
            answerSelect.disabled = answerSelect.hidden;
            answerInput.disabled = answerInput.hidden;
            answerNumber.disabled = answerNumber.hidden;
        })();
    </script>
}
