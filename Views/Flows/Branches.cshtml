@model GM_Toolbox.Models.ViewModels.FlowBranchesViewModel

@{
    ViewData["Title"] = "Branches";
}

<h1>Outcomes: @Model.StepLabel</h1>
<p>
    <a asp-action="Steps" asp-route-id="@Model.FlowID">Back to Steps</a>
</p>

@if (Model.CanBranch)
{
    <p class="text-muted">
        @Model.PositionPath of <strong>@Model.FlowName</strong>, rolling
        <strong>@Model.OracleName</strong>. Point an outcome at a table and a later
        &ldquo;roll what was picked&rdquo; step rolls it. Leave one alone and the flow just
        carries on to @Model.FallThroughLabel.
    </p>
}

<form asp-action="Branches" method="post">
    <input type="hidden" asp-for="FlowID" />
    <input type="hidden" asp-for="StepID" />

    <div asp-validation-summary="All" class="text-danger"></div>

    @if (!Model.CanBranch)
    {
        <div class="alert alert-info">
            This is a <strong>@Model.KindName</strong> step, and there is nothing fixed to branch
            on. It carries on to @Model.FallThroughLabel.
        </div>
    }
    else if (!Model.Rows.Any())
    {
        <p class="text-muted">
            This step's oracle has no outcomes yet, so there is nothing to branch on. Configure
            the oracle first.
        </p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th class="roll-log-key">@(Model.IsDice ? "Roll" : "Card")</th>
                    <th>Result</th>
                    <th>Picks table</th>
                    <th>Advanced</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.Rows.Count; i++)
                {
                    <tr>
                        <td>
                            <input type="hidden" asp-for="Rows[i].EntryID" />
                            @Model.Rows[i].OutcomeKey
                        </td>
                        <td>
                            @if (string.IsNullOrWhiteSpace(Model.Rows[i].Result))
                            {
                                <span class="text-muted">(no result text)</span>
                            }
                            else
                            {
                                @Model.Rows[i].Result
                            }
                        </td>
                        <td>
                            <select asp-for="Rows[i].OracleID" class="form-control form-control-sm">
                                <option value="">Nothing</option>
                                @foreach (var oracle in Model.Oracles)
                                {
                                    <option value="@oracle.ID">
                                        @oracle.Name &mdash; @oracle.GameSystemName@(oracle.NeedsSetup ? " (needs setup)" : "")
                                    </option>
                                }
                            </select>
                        </td>
                        <td>
                            <details>
                                <summary class="small text-muted">Go to a step / end the flow</summary>
                                <select asp-for="Rows[i].Target" class="form-control form-control-sm mt-1">
                                    <option value="">Carry on &mdash; @Model.FallThroughLabel</option>
                                    <option value="@GM_Toolbox.Models.ViewModels.BranchRow.EndTarget">End the flow here</option>
                                    @foreach (var target in Model.Targets)
                                    {
                                        <option value="@target.StepID">@target.Label</option>
                                    }
                                </select>
                            </details>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <button type="submit" class="btn btn-primary">Save outcomes</button>
    }

    <div class="mt-3">
        <a asp-action="Steps" asp-route-id="@Model.FlowID">Back to Steps</a>
    </div>
</form>
