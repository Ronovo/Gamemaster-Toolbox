@model GM_Toolbox.Models.Flow
@using GM_Toolbox.Models.Enums

@{
    ViewData["Title"] = "Details";

    var flow = Model;
    var blockedReason = flow.RunBlockedReason();

    Func<int?, string> targetLabel = stepId =>
    {
        if (stepId == null) return "ends the flow";
        var step = flow.Steps.FirstOrDefault(s => s.ID == stepId.Value);
        return step == null ? "ends the flow" : $"{step.PositionPath()}: {step.DisplayLabel()}";
    };

    var ordered = flow.InRunOrder().ToList();

    Func<GM_Toolbox.Models.FlowStep, int?> fallThrough = step =>
    {
        var idx = ordered.FindIndex(s => s.ID == step.ID);
        return idx >= 0 && idx + 1 < ordered.Count ? ordered[idx + 1].ID : (int?)null;
    };
}

<h1>@flow.Name</h1>

@if (blockedReason != null)
{
    <div class="alert alert-warning">@blockedReason</div>
}

<div>
    <h4>Flow</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@flow.Name</dd>

        @if (!string.IsNullOrWhiteSpace(flow.Description))
        {
            <dt class="col-sm-2">Description</dt>
            <dd class="col-sm-10">@flow.Description</dd>
        }

        <dt class="col-sm-2">Game System</dt>
        <dd class="col-sm-10">@flow.GameSystem?.Name</dd>
    </dl>
</div>

@if (ordered.Any())
{
    <h4>The chain</h4>
    <hr />
    <ol class="mb-3">
        @foreach (var step in ordered)
        {
            var entries = (step.Oracle?.OracleEntries ?? new List<GM_Toolbox.Models.OracleEntry>())
                .ToDictionary(e => e.ID);

            <li class="mb-2">
                <strong>@step.DisplayLabel()</strong>
                <span class="small text-muted">@step.Kind.DisplayName()</span>

                @switch (step.Kind)
                {
                    case FlowStepKind.Roll:
                        <div class="small text-muted">
                            @step.Oracle?.Name
                            @if (step.Oracle != null)
                            {
                                <text>&middot; @step.Oracle.TypeLabel()</text>
                            }
                        </div>
                        break;

                    case FlowStepKind.Choice:
                        <div class="small text-muted">@step.Question</div>
                        foreach (var option in step.Options.OrderBy(o => o.SortOrder))
                        {
                            <div class="small text-muted">
                                &bull; @option.Label
                                @if (option.Oracle != null)
                                {
                                    <text>&rarr; @option.Oracle.Name</text>
                                }
                                @if (option.EndsFlow)
                                {
                                    <text>&rarr; ends the flow</text>
                                }
                                else if (option.TargetStepID != null)
                                {
                                    <text>&rarr; @targetLabel(option.TargetStepID)</text>
                                }
                            </div>
                        }
                        break;

                    case FlowStepKind.Text:
                        <div class="small text-muted">@step.Question</div>
                        break;

                    case FlowStepKind.Loop:
                        <div class="small text-muted">@step.Prompt(flow)</div>
                        break;

                    case FlowStepKind.RollChosen:
                        var source = step.SourceStep(flow);
                        <div class="small text-muted">
                            @(source == null
                                ? "No source set"
                                : $"Rolls what {source.PositionPath()} ({source.DisplayLabel()}) picks")
                        </div>
                        break;
                }

                <div class="small">Otherwise &rarr; @targetLabel(fallThrough(step))</div>

                @if (step.AllowsBranches())
                {
                    foreach (var branch in step.Branches
                        .OrderBy(b => entries.TryGetValue(b.OracleEntryID, out var e) ? e.SortOrder : int.MaxValue))
                    {
                        var entry = entries.TryGetValue(branch.OracleEntryID, out var found) ? found : null;
                        <div class="small text-muted">
                            @(entry?.KeyLabel() ?? "?")@(string.IsNullOrWhiteSpace(entry?.Result) ? "" : $" — {entry!.Result}")
                            @if (branch.Oracle != null)
                            {
                                <text>&rarr; picks @branch.Oracle.Name</text>
                            }
                            @if (branch.EndsFlow)
                            {
                                <text>&rarr; ends the flow</text>
                            }
                            else if (branch.TargetStepID != null)
                            {
                                <text>&rarr; @targetLabel(branch.TargetStepID)</text>
                            }
                        </div>
                    }
                }
            </li>
        }
    </ol>
}
else
{
    <p class="text-muted">No steps yet. Use <strong>Steps</strong> to build the chain.</p>
}

@if (blockedReason == null && ordered.Any())
{
    <p>
        <a asp-action="Run" asp-route-id="@flow.ID" class="btn btn-primary">Run this flow</a>
    </p>
}

<div>
    <a asp-action="Steps" asp-route-id="@flow.ID">Steps</a> |
    <a asp-action="Edit" asp-route-id="@flow.ID">Edit</a> |
    <a asp-action="Delete" asp-route-id="@flow.ID">Delete</a> |
    <a asp-action="Index">Back to List</a>
</div>
