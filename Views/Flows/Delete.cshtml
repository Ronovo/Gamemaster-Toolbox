@model GM_Toolbox.Models.Flow

@{
    ViewData["Title"] = "Delete Flow";
}

<h1>Delete Flow</h1>

<h3>Are you sure you want to delete this?</h3>

<div>
    <h4>Flow</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Name</dd>

        <dt class="col-sm-2">Game System</dt>
        <dd class="col-sm-10">@Model.GameSystem?.Name</dd>

        <dt class="col-sm-2">Steps</dt>
        <dd class="col-sm-10">@Model.Steps.Count</dd>
    </dl>

    <p class="text-muted">
        This deletes the flow and its steps. The oracles it chains together are left alone
        &mdash; a flow borrows them, it does not own them.
    </p>

    <form asp-action="Delete">
        <input type="hidden" asp-for="ID" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index">Back to List</a>
    </form>
</div>
