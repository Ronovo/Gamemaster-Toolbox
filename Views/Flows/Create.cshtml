@model GM_Toolbox.Models.Flow

@{
    ViewData["Title"] = "Create Flow";

    // Without a game system and an oracle the form can't be submitted, so say so instead.
    var gameSystems = ViewBag.GameSystemID as SelectList;
    var hasGameSystems = gameSystems is not null && gameSystems.Any();
    var oracleCount = ViewData["OracleCount"] as int? ?? 0;
}

<h1>Create Flow</h1>

<h4>Flow</h4>
<hr />

@if (!hasGameSystems)
{
    <div class="row">
        <div class="col-md-6">
            <div class="alert alert-info" role="alert">
                <h5 class="alert-heading">Create a game system first</h5>
                <p>
                    Every flow belongs to a game system, and there aren't any yet.
                    Add the game you're running &mdash; then come back and build its flows.
                </p>
                <a asp-controller="GameSystems" asp-action="Create" class="btn btn-primary">Add a game system</a>
            </div>
        </div>
    </div>
}
else if (oracleCount == 0)
{
    <div class="row">
        <div class="col-md-6">
            <div class="alert alert-info" role="alert">
                <h5 class="alert-heading">Build some oracles first</h5>
                <p>
                    A flow chains oracles together, and there aren't any yet. Build two or more
                    &mdash; then come back and decide what order they roll in.
                </p>
                <a asp-controller="Oracles" asp-action="Create" class="btn btn-primary">Create an oracle</a>
            </div>
        </div>
    </div>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group">
                    <label asp-for="Name" class="control-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="form-group mt-4">
                    <label asp-for="Description" class="control-label"></label>
                    <input asp-for="Description" class="form-control" />
                    <span class="small text-muted">Optional. What this flow is for.</span>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="form-group mt-4">
                    <label asp-for="GameSystemID" class="control-label"></label>
                    <select asp-for="GameSystemID" class="form-control" asp-items="ViewBag.GameSystemID"></select>
                    <span asp-validation-for="GameSystemID" class="text-danger"></span>
                </div>

                <div class="form-group mt-4">
                    <input type="submit" value="Create" class="btn btn-primary" />
                    <a asp-action="Index" class="btn btn-link">Cancel</a>
                </div>
            </form>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
