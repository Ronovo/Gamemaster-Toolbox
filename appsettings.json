{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=App_Data/gmtoolbox.db"
  },
  // Quiet by default. This is a tool people run for themselves, often in a terminal they are
  // watching, so the console should stay empty while nothing is wrong. At Information the
  // framework narrates every page hit -- EF Core prints the full SQL of every query it runs --
  // which buries the one line that actually matters when something breaks. Warning is the floor
  // instead of Error so genuine problems that the app recovers from still surface.
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      // The exception to the above: this is the category that prints "Now listening on:
      // http://localhost:9000" and "Application started". That is the address someone needs to
      // open the app, so it stays visible.
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "ForceHttps": false
}
